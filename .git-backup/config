[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/priteesh-rahate/container-stowage-ai.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "improvements/vessel-voyage-features"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/improvements/vessel-voyage-features
